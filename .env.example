# Database
DATABASE_URL=postgresql+asyncpg://media_user:secure_password@postgres:5432/mediacatalog
DB_USER=media_user
DB_PASSWORD=secure_password
DB_NAME=mediacatalog

# Security
SECRET_KEY=your-very-secure-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Connection Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Application
DEBUG=True
